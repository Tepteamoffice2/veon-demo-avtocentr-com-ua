---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
const base = String(import.meta.env.BASE_URL).endsWith("/") ? String(import.meta.env.BASE_URL).slice(0, -1) : String(import.meta.env.BASE_URL);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" data-rec="U-R011" />
    <title data-rec="SEO-R002">{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:type" content="website" data-rec="SEO-R006" />
    <meta name="twitter:card" content="summary" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}/fonts/fira-sans-condensed-cyrillic-700-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body id="top" data-rec="P-R003">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="U-R008,U-R017"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
